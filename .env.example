# Container-local timezone used by Porter for local date/time behavior.
# Set this to the deployment's IANA timezone, for example America/New_York.
TZ=Etc/UTC

# Host-only published port. Compose binds this to 127.0.0.1.
PORTER_WEB_PORT=8000

# Porter-owned operational JSON log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
PORTER_LOG_LEVEL=INFO

# Ollama is intentionally not bridged into the container yet.
# Porter's Ollama adapter currently requires a loopback endpoint; do not add a
# non-loopback PORTER_OLLAMA_URL here to bypass that security invariant.

# Optional weather source token. Keep real tokens in .env, never in this file.
# PORTER_SYNOPIC_TOKEN=


# Optional monitoring stack ports. All are published on host loopback only.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Prometheus local retention window.
PROMETHEUS_RETENTION=15d

# Grafana local admin credentials. Set a unique password before starting the monitoring stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
